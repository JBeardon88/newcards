    },
    {
      "$ref": "#/definitions/return_from_discard"
    },
    {
      "$ref": "#/definitions/gain_attack"
    },
    {
      "$ref": "#/definitions/gain_defense"
    },
    {
      "$ref": "#/definitions/lose_attack"
    },
    {
      "$ref": "#/definitions/regenerate_health"
    },
    {
      "$ref": "#/definitions/grant_ability"
    },
    {
      "$ref": "#/definitions/conditional_gain_attack"
    },
    {
      "$ref": "#/definitions/equipment_cost_reduction"
    },
    {
      "$ref": "#/definitions/increase_energy_regen"
    }
  ]
