{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "effect.schema.json",
  "description": "Only these effect shapes are supported. Trigger/card and attachment compatibility is additionally checked by src/content/validate.ts.",
  "definitions": {
    "draw_cards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "draw_cards"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "trigger": {
          "enum": [
            "on_cast",
            "on_summon",
            "on_upkeep",
            "on_death",
            "on_play_equipment"
          ]
        }
      },
      "required": ["type", "value", "trigger"]
    },
    "deal_damage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "deal_damage"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "trigger": {
          "enum": [
            "on_cast",
            "on_summon",
            "on_upkeep",
            "on_death",
            "on_play_equipment"
          ]
        },
        "target": {
          "enum": ["enemy_creature", "creature", "creature_or_player"]
        }
      },
      "required": ["type", "value", "trigger", "target"]
    },
    "increase_energy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "increase_energy"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "trigger": {
          "enum": [
            "on_cast",
            "on_summon",
            "on_upkeep",
            "on_death",
            "on_play_equipment"
          ]
        },
        "duration": {
          "enum": ["this_turn", "end_of_turn"]
        }
      },
      "required": ["type", "value", "trigger"]
    },
    "summon_token": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "summon_token"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "trigger": {
          "enum": [
            "on_cast",
            "on_summon",
            "on_upkeep",
            "on_death",
            "on_play_equipment"
          ]
        }
      },
      "required": ["type", "value", "trigger"]
    },
    "destroy_equipment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "destroy_equipment"
        },
        "trigger": {
          "enum": [
            "on_cast",
            "on_summon",
            "on_upkeep",
            "on_death",
            "on_play_equipment"
          ]
        },
        "target": {
          "enum": ["equipment", "enemy_equipment"]
        }
      },
      "required": ["type", "trigger", "target"]
    },
    "destroy_enchantment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "destroy_enchantment"
        },
        "trigger": {
          "enum": [
            "on_cast",
            "on_summon",
            "on_upkeep",
            "on_death",
            "on_play_equipment"
          ]
