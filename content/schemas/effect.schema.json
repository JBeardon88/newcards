        "trigger": {
          "enum": [
            "on_cast",
            "on_summon",
            "on_upkeep",
            "on_death",
            "on_play_equipment"
          ]
        },
        "target": {
          "enum": [
            "creature",
            "equipped_creature",
            "enchanted_creature",
            "all_enemy_creatures",
            "all_creatures_you_control"
          ]
        },
        "duration": {
          "enum": ["this_turn", "end_of_turn"]
        }
      },
      "required": ["type", "value", "trigger", "target", "duration"]
    },
    "regenerate_health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "regenerate_health"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "trigger": {
          "const": "on_upkeep"
        },
        "target": {
          "enum": ["creature", "equipped_creature", "enchanted_creature"]
        }
      },
      "required": ["type", "value", "trigger", "target"]
    },
    "grant_ability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "grant_ability"
        },
        "value": {
          "const": "mycelium_network"
        },
        "trigger": {
          "const": "constant"
        },
        "target": {
          "enum": ["creature", "equipped_creature", "enchanted_creature"]
        }
      },
      "required": ["type", "value", "trigger", "target"]
    },
    "conditional_gain_attack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "conditional_gain_attack"
        },
        "value": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991
        },
        "trigger": {
          "const": "on_equip"
        },
        "condition": {
          "const": "equipped"
        }
      },
      "required": ["type", "value", "trigger", "condition"]
    },
    "equipment_cost_reduction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "equipment_cost_reduction"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "trigger": {
          "const": "constant"
        }
      },
      "required": ["type", "value", "trigger"]
    },
    "increase_energy_regen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "increase_energy_regen"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "trigger": {
          "enum": ["constant", "on_upkeep"]
        }
      },
      "required": ["type", "value", "trigger"]
