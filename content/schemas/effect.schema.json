            "condition": {
              "const": "mycelium_network"
            }
          },
          "required": ["type", "value", "trigger", "target"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "gain_defense"
            },
            "value": {
              "type": "integer",
              "maximum": 9007199254740991,
              "minimum": -9007199254740991
            },
            "trigger": {
              "enum": [
                "on_cast",
                "on_summon",
                "on_upkeep",
                "on_death",
                "on_play_equipment"
              ]
            },
            "target": {
              "enum": [
                "creature",
                "equipped_creature",
                "enchanted_creature",
                "all_enemy_creatures",
                "all_creatures_you_control"
              ]
            }
          },
          "required": ["type", "value", "trigger", "target"]
        }
      ]
