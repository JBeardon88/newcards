    "return_from_discard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "return_from_discard"
        },
        "trigger": {
          "enum": [
            "on_cast",
            "on_summon",
            "on_upkeep",
            "on_death",
            "on_play_equipment"
          ]
        },
        "target": {
          "enum": ["creature"]
        }
      },
      "required": ["type", "trigger", "target"]
    },
    "gain_attack": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "gain_attack"
            },
            "value": {
              "type": "integer",
              "maximum": 9007199254740991,
              "minimum": -9007199254740991
            },
            "trigger": {
              "const": "constant"
            },
            "target": {
              "enum": [
                "creature",
                "equipped_creature",
                "enchanted_creature",
                "creatures_you_control_with_mycelium_network"
              ]
            },
            "condition": {
              "const": "mycelium_network"
            }
          },
          "required": ["type", "value", "trigger", "target"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "gain_attack"
            },
            "value": {
              "type": "integer",
              "maximum": 9007199254740991,
              "minimum": -9007199254740991
            },
            "trigger": {
              "enum": [
                "on_cast",
                "on_summon",
                "on_upkeep",
                "on_death",
                "on_play_equipment"
              ]
            },
            "target": {
              "enum": [
                "creature",
                "equipped_creature",
                "enchanted_creature",
                "all_enemy_creatures",
                "all_creatures_you_control"
              ]
            },
            "duration": {
              "enum": ["this_turn", "end_of_turn"]
            }
          },
          "required": ["type", "value", "trigger", "target"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "gain_attack"
            },
            "value": {
              "type": "integer",
              "maximum": 9007199254740991,
              "minimum": -9007199254740991
            },
            "trigger": {
              "const": "on_attack"
            },
            "target": {
              "const": "attacking_creature"
            },
            "duration": {
              "const": "end_of_turn"
            }
          },
          "required": ["type", "value", "trigger", "target", "duration"]
        }
      ]
    },
    "gain_defense": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "gain_defense"
            },
            "value": {
              "type": "integer",
              "maximum": 9007199254740991,
              "minimum": -9007199254740991
