{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "keyword.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "implemented": {
      "type": "boolean"
    },
    "rulesNotes": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "implemented",
    "rulesNotes",
    "parameters"
  ]
}
