{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "card.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "definitionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "setId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "cardType": {
      "enum": ["CREATURE", "SPELL", "ARTIFACT", "AUGMENTATION"]
    },
    "rarity": {
      "enum": ["COMMON", "UNCOMMON", "RARE", "LEGENDARY"]
    },
    "cost": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "attack": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "health": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rulesText": {
      "type": "string"
    },
    "flavorText": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "effect.schema.json"
      }
    },
    "art": {
      "enum": ["funguys", "technocracy"],
      "description": "An existing CSS placeholder theme; image rendering or new themes require application work."
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "definitionId",
    "name",
    "setId",
    "cardType",
    "rarity",
    "cost",
    "attack",
    "health",
    "rulesText",
    "flavorText",
    "keywords",
    "effects",
    "art"
  ]
}
