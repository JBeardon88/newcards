{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "set.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "setId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "starterPacks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "common": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uncommon": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rare": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "legendaryChance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["common", "uncommon", "rare", "legendaryChance"]
    },
    "art": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "enum": ["funguys", "technocracy"]
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["theme", "symbol", "title"]
    }
  },
  "required": [
    "setId",
    "name",
    "description",
    "version",
    "starterPacks",
    "pack",
    "art"
  ]
}
