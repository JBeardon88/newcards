{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rarity.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "enum": ["COMMON", "UNCOMMON", "RARE", "LEGENDARY"]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["id", "name", "description"]
}
